rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/tasks/{taskId} {
      // 自分のタスクのみ読み取り・作成・更新を許可
      allow read, create, update: if request.auth != null
                                  && request.auth.uid == userId;
      // 物理削除は禁止（論理削除のみ許可）
      allow delete: if false;
    }
  }
}
